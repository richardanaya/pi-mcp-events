	"description": "Pi extension that discovers MCP event types on configured servers and manages subscriptions",
	"license": "MIT",
	"type": "module",
	"author": "Richard Anaya",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/richardanaya/pi-mcp-events.git"
	},
	"bugs": {
		"url": "https://github.com/richardanaya/pi-mcp-events/issues"
	},
	"homepage": "https://github.com/richardanaya/pi-mcp-events#readme",
	"keywords": ["pi", "mcp", "events", "extension"],
	"engines": {
		"node": ">=22.19.0"
	},
